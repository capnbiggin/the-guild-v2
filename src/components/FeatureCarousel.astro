---
import { Card, CardContent, CardHeader } from "@/components/starwind/card";
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "@/components/starwind/carousel";

import data from "../data/feature.json";
---

<Carousel
  id="carousel-autoplay"
  autoInit={false}
  opts={{ align: "start", loop: true }}
  class="mx-auto w-full max-w-md md:max-w-xl lg:max-w-4xl "
>
  <CarouselContent>
    {
    data.map((feature) => 
        <CarouselItem class="basis-1/1 md:basis-1/2 lg:basis-1/3 ">
            <Card size="sm" class="bg-slate-800 border-slate-600 text-slate-200">
                <img 
                    src={feature.image} 
                    alt={feature.title} 
                    class="aspect-video "
                    >
                <CardHeader class="font-extrabold text-lg">
                    <a href={feature.link}>{feature.title}</a>
                </CardHeader>
                <CardContent>
                    {feature.content}
                </CardContent>
            </Card>
        </CarouselItem>
      )
    }
  </CarouselContent>
  <CarouselPrevious />
  <CarouselNext />
</Carousel>

<script>
  import Autoplay from "embla-carousel-autoplay";

  import { initCarousel } from "@/components/starwind/carousel";

  function initAutoplayCarousel() {
    const carouselElement = document.getElementById("carousel-autoplay");
    if (!carouselElement) return;
    initCarousel(carouselElement, {
      plugins: [
        Autoplay({
          delay: 4000,
        }),
      ],
    });
  }

  initAutoplayCarousel();

  document.addEventListener("astro:after-swap", initAutoplayCarousel);
</script>