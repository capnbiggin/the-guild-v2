---
// Componit Imports
import StoreMap from "../components/StoreMap.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Contact Us">
  <h1 class="flex justify-center text-6xl font-bold">Contact Us</h1>
  <!-- Store Hours -->
  <div class="flex flex-col justify-center items-center">
    <h2 class="text-4xl font-simibold">Store Hours</h2>
    <p class="text-2xl">Sun - Thur | Noon - 8PM</p>
    <p class="text-2xl">Fri and Sat | Noon - Midnight</p>
  </div>
  <!-- Contacts -->
  <div class="flex flex-wrap justify-center items-center gap-8">
    <div class="flex flex-col justify-center items-center">
      <h3 class="text-3xl font-bold">Phone</h3>
      <p class="text-xl">205-530-0088</p>
    </div>
    <div class="flex flex-col justify-center items-center">
      <h3 class="text-3xl font-bold">Email</h3>
      <p class="text-xl">gamersguildal@gmail.com</p>
    </div>
  </div>
  <!-- Address -->
  <div class="flex justify-center">
    <p>4330 Hwy 78 E suite 110, Jasper, AL 35504</p>
  </div>

  <StoreMap />
</MainLayout>
